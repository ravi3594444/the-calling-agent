# ---- AssemblyAI Voice Agent API ----
# Get from https://www.assemblyai.com/dashboard -> API Keys
ASSEMBLYAI_API_KEY=

# WebSocket endpoint. Docs list /v1/ws; the official Twilio example uses
# /v1/realtime. If you get a 404 on connect, try the other one.
ASSEMBLYAI_AGENT_WS_URL=wss://agents.assemblyai.com/v1/ws

# ---- Agent behaviour ----
# Voice. "arjun" is multilingual (Hindi/Hinglish, code-switches with English).
# Other confirmed ids: diego (LatAm Spanish), james (conversational US male),
# sophie (clear UK female), claire, ivy. AssemblyAI publishes 18 English and
# 16 multilingual voices, so ids beyond these may also work -- the page has a
# picker, and /ws?voice=<id> overrides this for one call without redeploying.
AGENT_VOICE=arjun
AGENT_GREETING=Thanks for calling The Copper Kettle, this is Meera. How can I help?
# Optional: bind to a stored agent created via the Agents REST API.
# If set, system prompt / greeting / tools are applied server-side and the
# inline config below is ignored (the two modes are mutually exclusive).
AGENT_ID=

# ---- Latency / turn detection ----
# The biggest lever on how fast the agent feels. min_silence is how long you
# must stop talking before it decides you are done.
#   lower  = snappier replies, but it may cut you off mid-sentence
#   higher = more patient, but longer pauses before it answers
# Defaults below are tuned for speed. If replies clip your speech, raise
# AGENT_MIN_SILENCE_MS to 500-700.
AGENT_TURN_DETECTION=true
AGENT_MIN_SILENCE_MS=320
AGENT_MAX_SILENCE_MS=1500
# 0.0-1.0; raise in a noisy room so background sound is not heard as speech.
AGENT_VAD_THRESHOLD=0.5
# Whether you can interrupt the agent mid-sentence.
AGENT_ALLOW_INTERRUPTIONS=true

# ---- Restaurant ----
RESTAURANT_NAME=The Copper Kettle
RESTAURANT_CUISINE=modern North Indian food
RESTAURANT_ADDRESS=
RESTAURANT_MAX_PARTY=12

# ---- Server ----
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ---- Deployment ----
# Your DuckDNS hostname, e.g. my-agent.duckdns.org
PUBLIC_HOSTNAME=

# ---- Database (PRD §6-7) ----
# The whole product's truth. The hold transaction is defined by Postgres row
# locks, so there is no sqlite fallback -- and a "fallback" that could
# double-book would be worse than no database at all.
DATABASE_URL=postgresql+psycopg://tableline:tableline@localhost:5432/tableline
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Apply migrations on boot. Handy locally; in production migrations belong to
# the deploy, not to whichever web process happens to start first.
MIGRATE_ON_START=false

# ---- Tenancy ----
# Which venue a transport with no dialled number answers for (the browser
# client). A POINTER to a row, never behaviour: nothing branches on its value.
DEFAULT_BUSINESS_SLUG=demo

# ---- Dashboard ----
# Dashboard links are stored hashed with this pepper, so a database dump alone
# opens nobody's dashboard. CHANGING IT INVALIDATES EVERY LIVE LINK.
TOKEN_PEPPER=
# Where the manage link in a confirmation text points.
DASHBOARD_BASE_URL=
# Development only: open the dashboard with no token at all. Needs BOTH.
DEV_DASHBOARD_BUSINESS=
ALLOW_INSECURE_DASHBOARD=false

# ---- Background jobs ----
# Expired holds must give their capacity back or the room fills with ghosts.
SWEEP_INTERVAL_SECONDS=60
# Run the sweeper and the message queue inside the web process. Correct for
# one server; turn it off and run `python -m calling_agent.jobs` when there
# are several.
RUN_JOBS_IN_PROCESS=true

# ---- Telephony (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Refuse webhooks Twilio did not sign. Only turn this off locally.
VERIFY_TWILIO_SIGNATURE=true

# ---- Messaging ----
# "log" records the message and sends nothing -- the default, so a fresh
# checkout cannot text a real person on its first run. "twilio" sends.
SMS_PROVIDER=log
